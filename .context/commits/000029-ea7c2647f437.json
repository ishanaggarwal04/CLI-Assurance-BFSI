90d019b2c199fc5a5485dc4431","props":{}},{"ecid":"sha256:09507ef0451db90c6259934e3c2829daaaa459e98645fcc153e6711a7f34a468","type":"exercises","src":"sha256:6ef5fc5017f5a49694ae512049254f32590830826afde2259236f243607df75b","dst":"sha256:0ee196d8796449ce2cb94c4e2c796b228525722d871c65db4df5fa9800175e97","props":{}}],"review":[],"supersessions":[],"source_head_moves":{},"names":[{"cid":"sha256:e5b16438f0677b6bbbeb778b3542bb3644d1195e74d7841c85600bf9fda7c9f9","slug":"ac-28","by":{"kind":"ai","id":"design-agent"}}],"judgements":[{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Applicable because sc-9 is the standard_user exclusion path and directly proves that admin-only capabilities are not inherited by a standard user.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Not applicable because ac-25 is explicitly about successful authentication as admin_user reaching the intended administrative experience, which sc-9 does not exercise.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Not applicable because ac-26 requires an admin_user session exposing authorized administrative capability or data, while sc-9 is intentionally a standard_user session.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Not applicable because ac-27 is scoped to the admin_user session's distinct administrative information or controls, which sc-9 does not create.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Not applicable because ac-24 is the prohibition on standard_user inheritance of admin-only capabilities, and sc-10 authenticates as admin_user instead.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Applicable because sc-10 is the admin_user authentication path and directly proves the transition into the intended administrative experience.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Applicable because sc-10 exists to observe the administrative capabilities or data exposed to the admin persona.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","rationale":"[applicability] Applicable because sc-10 is the path where administrative information or controls must be distinguishable from ordinary customer-facing banking information.","by":{"kind":"ai","id":"design-agent"}}],"design_of":{"uc_cid":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","engine":"design@1"},"event_ids":["design-20260911T081714-e57c:design:3"],"sid":"design-20260911T081714-e57c","design_phase":{"uc_root":"sha256:5ea5ef780d199b3f5049d7732829d4becf41c987726578e7227dd6e54449faea","generation":1,"phase":"wiring","completeness":"complete"},"schema_version":"assurance/context@1","parents":["sha256:15a67f99528b1f6fe4dc5964ed8154377faa1443cb390e73ce5e43674df16952"]}
